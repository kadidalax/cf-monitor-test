# Cloudflare 部署按钮 / Wrangler 本地开发模板。
# SUPABASE_URL 是普通 Worker Variable；放在这里是为了让部署按钮提示填写。
SUPABASE_URL=https://PROJECT_REF.supabase.co

# 以下值必须保存为 Worker Secret，不要保存为普通变量。
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
JWT_SECRET=replace-with-a-long-random-local-dev-secret-at-least-32-bytes
# Optional: reject Agent tokens older than this many days.
# Leave unset until existing nodes have been rotated or verified.
# AGENT_TOKEN_MAX_AGE_DAYS=180
# Optional: allows full /api/setup/status diagnostics after setup; use at least 32 bytes.
# SETUP_DIAGNOSTICS_TOKEN=replace-with-a-random-setup-diagnostics-token-32-bytes
# Optional: public demo mode. Restores the saved demo snapshot every 30 minutes.
# DEMO_RESET_ENABLED=true
